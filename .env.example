# ---------------------------------------------------------------------------
# EXAMPLE settings file.
#
# HOW TO USE THIS FILE
#   1. Make a copy named exactly ".env"   ->   cp .env.example .env
#   2. Fill in the two required values below.
#   3. Never commit .env. It is already listed in .gitignore.
#
# The leading dot in ".env" makes it hidden in Finder. That is normal.
# Format is NAME=value, one per line. No spaces around the "=", no quotes
# needed, and anything after a # is a comment.
# ---------------------------------------------------------------------------


# === REQUIRED ==============================================================

# Your Supabase project's web address.
# WHERE TO FIND IT: supabase.com -> your project -> Settings (gear icon)
#   -> "API" -> "Project URL". It looks like the line below.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service role key. This is a long string starting with "eyJ".
# SAME PAGE: Settings -> API -> "Project API keys" -> service_role -> Reveal.
#
# TREAT THIS LIKE THE KEY TO THE DEALERSHIP. It bypasses every security rule
# in your database. It belongs in this file and in GitHub Secrets, nowhere
# else. Never paste it into a chat, a ticket, or a Python file.
#
# We need the service_role key (not the anon key) because the scraper writes
# rows, and a fresh Supabase project blocks anonymous writes by default.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# === OPTIONAL ==============================================================
# Everything below has a sensible default. Leave it out unless you need it.

# The public, read-only key. Same page as above, listed as "anon public".
# The scraper does not use it. Add it only if you later build a dashboard or
# a web page that reads this data in a browser.
# SUPABASE_ANON_KEY=your-anon-key-here

# How the scraper introduces itself to the websites it visits.
#
# LEAVE THIS UNSET. The scraper already sends a normal browser identity and
# knows how to get Dealer Inspire sites to answer. Setting this turns that
# off, and a custom bot name is exactly what dealer-site bot filters refuse,
# so those competitors would start returning zero vehicles.
# SCRAPER_USER_AGENT=

# How many vehicle pages to download at the same time.
# Default is 5. Higher is faster but leans harder on someone else's web
# server. Do not raise this above 10. If a site starts returning 403 errors,
# lower it to 2 or 3 and the errors usually stop.
# SCRAPER_WORKERS=5

# Obey the full Crawl-delay a site asks for in its robots.txt.
# Some sites politely request 10+ seconds between page loads, which can turn
# a run into an hour. By default the scraper honors robots.txt rules about
# WHICH pages it may read, and applies a ~1 second courtesy pause between
# requests. Set this to "true" to also wait the full delay a site requests.
# HONOR_FULL_CRAWL_DELAY=false
